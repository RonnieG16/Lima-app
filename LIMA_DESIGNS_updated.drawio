        </mxCell>
        <mxCell id="arch-25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE3E1;strokeColor=#B3261E;fontSize=12;" value="Pesapal API 3.0: hosted checkout, GetTransactionStatus, IPN (sandbox or live)" vertex="1">
