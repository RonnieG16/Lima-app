  <diagram name="Architecture" id="arch-page-lima">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1200" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="arch-2" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=left;" value="Lima architecture (Supabase backend)" vertex="1">
          <mxGeometry height="34" width="700" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="arch-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B3261E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#B3261E;" value="Trust boundary 1: user devices (untrusted)" vertex="1">
          <mxGeometry height="430" width="220" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="arch-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B3261E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#B3261E;" value="Trust boundary 2: static hosting (Netlify / Vercel / GitHub Pages, HTTPS)" vertex="1">
          <mxGeometry height="430" width="260" x="300" y="70" as="geometry" />
        </mxCell>
        <mxCell id="arch-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B3261E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#B3261E;" value="Trust boundary 3: Supabase project (managed, HTTPS only)" vertex="1">
          <mxGeometry height="430" width="560" x="600" y="70" as="geometry" />
        </mxCell>
        <mxCell id="arch-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#5B7FD6;fontSize=12;" value="Users: buyer, farmer, field agent, rider, admin (mobile browser, 3G/4G)" vertex="1">
          <mxGeometry height="90" width="180" x="60" y="110" as="geometry" />
        </mxCell>
        <mxCell id="arch-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A94A6;dashed=1;fontSize=12;" value="Basic-phone farmers: via field agent (SMS/USSD gateway is out of MVP scope)" vertex="1">
          <mxGeometry height="90" width="180" x="60" y="260" as="geometry" />
        </mxCell>
        <mxCell id="arch-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3E6;strokeColor=#2E6B34;fontSize=12;" value="Presentation layer: static web app (HTML, CSS, JS ES module; supabase-js client; role-based screens; installable PWA with phone menu, hosted on Netlify)" vertex="1">
          <mxGeometry height="110" width="220" x="320" y="110" as="geometry" />
        </mxCell>
        <mxCell id="arch-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A94A6;fontSize=12;" value="jsDelivr CDN: supabase-js library (pinned version)" vertex="1">
          <mxGeometry height="70" width="220" x="320" y="280" as="geometry" />
        </mxCell>
        <mxCell id="arch-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#D49A00;fontSize=12;" value="Supabase Auth: email + password, JWT sessions, signup trigger creates profile; field-agent accounts start pending admin approval (admin role cannot be self-selected)" vertex="1">
          <mxGeometry height="100" width="250" x="620" y="110" as="geometry" />
        </mxCell>
        <mxCell id="arch-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#D49A00;fontSize=12;" value="PostgREST API gateway: validates the JWT, runs every query as role &#39;authenticated&#39;" vertex="1">
          <mxGeometry height="80" width="250" x="620" y="240" as="geometry" />
        </mxCell>
        <mxCell id="arch-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3E6;strokeColor=#2E6B34;fontSize=12;" value="PostgreSQL: RLS, escrow, cancel_order and admin functions, site_settings for branding/media, profiles.approval_status, listings.status (available, sold out, hidden), notifications for admin alerts" vertex="1">
          <mxGeometry height="170" width="240" x="900" y="110" as="geometry" />
        </mxCell>
        <mxCell id="arch-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#D49A00;fontSize=12;" value="Supabase Storage: &#39;photos&#39; bucket (images up to 10 MB; weather background video up to 30 MB)" vertex="1">
          <mxGeometry height="80" width="240" x="900" y="320" as="geometry" />
        </mxCell>
        <mxCell id="arch-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3E6;strokeColor=#2E6B34;fontSize=12;" value="Supabase Edge Functions: pay-start creates Pesapal checkout; pay-webhook verifies IPN and marks escrow held. Secrets server-side only." vertex="1">
